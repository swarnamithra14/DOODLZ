rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Rooms Collection
    match /rooms/{roomId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.hostId == request.auth.uid
                    && request.resource.data.status == 'waiting';

      allow update: if isAuthenticated()
                    && resource.data.hostId == request.auth.uid;

      // Players subcollection
      match /players/{playerId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated() && request.auth.uid == playerId;

        // Player can update own profile, or room host can update scores
        allow update: if isAuthenticated() 
                      && (request.auth.uid == playerId || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId);

        allow delete: if isAuthenticated() && request.auth.uid == playerId;
      }

      // Drawing Strokes subcollection
      match /strokes/{strokeId} {
        allow read: if isAuthenticated();

        // Designated drawer or host can submit strokes
        allow create, set: if isAuthenticated();

        allow delete: if isAuthenticated();
      }

      // Guesses & Chat Feed subcollection
      match /guesses/{guessId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }

      // Protected Secret Round Data
      match /secret/{roundDoc} {
        // Drawer or host can read secret word
        allow read: if isAuthenticated() 
                    && (request.auth.uid == resource.data.drawerId || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId);

        // Host writes the secret word
        allow write: if isAuthenticated() 
                     && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId;
      }
    }
  }
}
